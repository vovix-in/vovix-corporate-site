# Copy to .env.local for development. Set the same keys in Vercel for Preview/Production.

# Contact form → Gmail API (app/api/contact/route.ts). Without these the form
# falls back to opening the visitor's mail app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# CONTACT_TO=admin@vovix.in

# Analytics (lib/analytics.ts). All optional. Nothing loads until the visitor
# allows it in the consent banner; leave both empty and no banner is shown.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# Booking embed shown on /contact#schedule and linked from the Payroll CTA
# (components/scheduler.tsx). Google Calendar appointment schedule, Cal.com or
# Calendly "embed" URL. Leave empty to hide the block.
NEXT_PUBLIC_SCHEDULER_URL=
